# Revalidate application entry points so PWA updates can be discovered.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/studio
  Cache-Control: no-cache

/studio/
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Vite fingerprints every file it emits in this directory.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
